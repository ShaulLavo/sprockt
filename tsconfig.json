{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable", "WebWorker"],
    "types": ["vite/client", "bun", "@webgpu/types"],
    "jsx": "react-jsx",
    "strict": true,
    // Waffle, bun-wasm and bash-web ship TypeScript source, so these flags check their code too.
    // Flags they do not build with (noImplicitOverride) stay off.
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src", "worker", "e2e", "scripts", "vite.config.ts", "playwright.config.ts"]
}
