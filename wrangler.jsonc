{
  // sprockt.dev: the built app as static assets. Cross-origin isolation headers come from
  // public/_headers. Deep links (/w/<id>, /github/<owner>/<repo>) fall back to index.html for
  // navigations only, so a missing guest or worker still answers 404.
  // Only /api/* runs the Worker (worker/index.ts): the GitHub import proxy. Every other path is
  // answered by the assets without running any code.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sprockt",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-15",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  // Per-address limit on the proxy routes that spend GitHub API quota (repo, refs).
  "ratelimits": [
    { "name": "GITHUB_API_LIMITER", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } },
  ],
  // Optional secret: GITHUB_TOKEN (no scopes) raises the API limit; set with `wrangler secret put`.
  "routes": [{ "pattern": "sprockt.dev", "custom_domain": true }],
}
