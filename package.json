{
  "name": "sprockt",
  "version": "0.0.1",
  "private": true,
  "description": "Open-source browser IDE built on Waffle, bun-wasm, bash-web, Singapore and Ghostty WebGPU",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "bun scripts/fetch-guests.ts && vite build",
    "preview": "vite preview",
    "guests": "bun scripts/fetch-guests.ts",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check:javascript": "bun scripts/check-javascript.ts",
    "test": "bun test ./src ./scripts",
    "check": "bun run format:check && bun run lint && bun run check:javascript && bun run typecheck && bun run test",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@shaulavo/hotkeys": "0.0.4",
    "@singapore-editor/core": "0.2.13",
    "@singapore-editor/find": "0.2.13",
    "@singapore-editor/gutters": "0.2.13",
    "@singapore-editor/highlighting": "0.2.16",
    "@singapore-editor/solid": "0.2.13",
    "@waffle-os/relay": "0.0.148",
    "bash-web": "0.0.114",
    "bun-wasm": "git+https://github.com/ShaulLavo/bun-wasm.git#7b25271e30bd41ca54d115d01d557084068cf930",
    "ghostty-webgpu": "0.3.34",
    "solid-js": "1.9.20",
    "waffle": "npm:@waffle-os/runtime@0.0.148",
    "waffle-base": "https://github.com/ShaulLavo/waffle/releases/download/programs-v0.0.23/waffle-base-0.0.23.tgz"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/bun": "1.4.4",
    "oxfmt": "0.70.0",
    "oxlint": "1.88.0",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vite-plugin-solid": "2.11.17",
    "wrangler": "4.151.0"
  },
  "trustedDependencies": [
    "bun-wasm"
  ]
}
