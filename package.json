{
  "name": "sprockt",
  "version": "0.0.1",
  "private": true,
  "description": "Open-source browser IDE built on Waffle, bun-wasm, bash-web, Singapore and Ghostty WebGPU",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "bun scripts/fetch-guests.ts && vite build",
    "preview": "vite preview",
    "guests": "bun scripts/fetch-guests.ts",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check:javascript": "bun scripts/check-javascript.ts",
    "test": "bun test ./src ./worker ./scripts",
    "check": "bun run format:check && bun run lint && bun run check:javascript && bun run typecheck && bun run test",
    "test:e2e": "playwright test",
    "agent:browser": "bun scripts/agent/browser.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/schibsted-grotesk": "5.3.0",
    "@shaulavo/hotkeys": "0.0.4",
    "@shaulavo/workbench": "0.1.20",
    "@singapore-editor/core": "0.2.14",
    "@singapore-editor/find": "0.2.14",
    "@singapore-editor/gutters": "0.2.14",
    "@singapore-editor/highlighting": "0.2.17",
    "@singapore-editor/lsp": "0.2.13",
    "@singapore-editor/lsp-plugin": "0.2.17",
    "@singapore-editor/plugin-ui": "0.2.14",
    "@singapore-editor/react": "0.2.14",
    "@waffle-os/relay": "0.0.150",
    "bash-web": "0.0.114",
    "bun-wasm": "git+https://github.com/ShaulLavo/bun-wasm.git#a997a2069c5201c75c83e6eb68e0995a8f7254f5",
    "ghostty-webgpu": "0.3.34",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "waffle": "npm:@waffle-os/runtime@0.0.150",
    "waffle-base": "https://github.com/ShaulLavo/waffle/releases/download/programs-v0.0.23/waffle-base-0.0.23.tgz"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/bun": "1.4.4",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "fflate": "0.8.3",
    "oxfmt": "0.70.0",
    "oxlint": "1.88.0",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "wrangler": "4.151.0"
  },
  "trustedDependencies": [
    "bun-wasm"
  ]
}
